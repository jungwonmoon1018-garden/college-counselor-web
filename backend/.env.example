# Development-only overrides. The packaged desktop app stores its three
# administrator-managed secrets with the operating system credential store.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Generate 32 random bytes and encode them as 64 hexadecimal characters.
ENCRYPTION_KEY=

# The only external model provider supported by the application.
OPENROUTER_API_KEY=

# Free key for the official IPEDS / College Scorecard API.
SCORECARD_API_KEY=

# Website deployment only. Keep these platform-managed values outside the
# counselor UI; counselor-entered keys are encrypted under WEB_CONFIG_KEY.
WEB_CONFIG_KEY=
WEB_ADMIN_BOOTSTRAP_TOKEN=
PUBLIC_APP_URL=
DATA_DIR=
