{
  "name": "college-counselor-backend",
  "version": "1.0.0",
  "description": "Local, evidence-grounded college counseling backend",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate:colleges": "node scripts/generate-college-profiles.mjs",
    "refresh:colleges": "node scripts/refresh-college-data.mjs",
    "cds:add-cycle": "node scripts/add-cds-cycle.mjs",
    "refresh:cds": "node scripts/refresh-cds.mjs",
    "seed:embeddings": "node scripts/seed-embeddings.mjs",
    "start": "node server.js",
    "start:web": "node web-launcher.mjs",
    "start:sim": "node simulation-sidecar.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings=500"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "mammoth": "^1.8.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
