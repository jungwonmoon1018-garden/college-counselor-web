# ───────────────────────────────────────────────────────────────
# Monorepo root ignore. Each package (backend/, frontend/) also keeps
# its own .gitignore; these patterns are defense-in-depth so real
# student PII and secrets can never reach a remote.
# ───────────────────────────────────────────────────────────────

# Dependencies
**/node_modules/

# Builds
**/dist/
**/bin/
**/obj/
frontend/playwright-report/
frontend/test-results/
backend/public/
/test-results/

# Editor / local tooling
.claude/launch.json

# Environment / secrets
**/.env
**/.env.local
**/.env.bak-*
**/.env.tmp-*
*.enc.json
**/.dev-encryption-key

# Databases — contain real student PII + BYOK keys. NEVER commit.
*.db
*.db-wal
*.db-shm
**/data/
**/.db-backups/

# Generated / large artifacts
**/generated/
eng.traineddata

# graphify knowledge-graph output is generated — keep only the hand-written
# change summaries under recent-changes/, ignore the rest (graph.json/html,
# obsidian vault, cache).
/graphify-out/*
!/graphify-out/recent-changes/

# Accidental nested checkout of this same repo — never commit as a gitlink.
/college-counselor/

# Logs
*.log
**/logs/

# OS noise
.DS_Store
Thumbs.db
